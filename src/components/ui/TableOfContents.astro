---
import { themeConfig } from '@/config'
import type { TOCProps } from '@/types'

const { toc = [] }: TOCProps = Astro.props
---

<div class="toc-container" id="toc">
  <nav class="toc-nav">
    <ul class="toc-list" id="toc-list">
      <!-- Back to top link -->
      <li class="toc-item toc-level-0">
        <a href="#" class="toc-link toc-title" data-text="Back to top">
          {' '}
          Back to top{' '}
        </a>
      </li>

      <!-- TOC items -->
      {toc.map((item) => (
        <li class={`toc-item toc-level-${item.level}`}>
          <a href={`#${item.id}`} class="toc-link" data-text={item.text}>
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<script
  is:inline
  define:vars={{
    contentWidth: themeConfig.general.contentWidth,
    centeredLayout: themeConfig.general.centeredLayout,
    toc: themeConfig.post.toc
  }}
>
  ;(function () {
    if (window.__tocController?.destroy) {
      window.__tocController.destroy()
    }

    const activeOffset = 128
    const jumpOffset = 96

    // Core state
    const state = {
      container: null,
      linkList: [],
      headingList: [],
      titleLink: null,
      headingMap: new Map(),
      scrollFrame: null,
      resizeTimeout: null,
      resetTimeout: null,
      activeLink: null,
      activeId: null,
      hasContent: false,
      expanded: false,
      hoveredIndex: -1
    }

    // Initialize DOM elements
    function initElements() {
      state.container = document.querySelector('.toc-container')
      if (!state.container) return false

      state.linkList = Array.from(document.querySelectorAll('.toc-link'))
      state.headingList = Array.from(document.querySelectorAll('h1, h2, h3')).filter(
        (heading, index, headings) => !(index === 0 && headings[0].tagName === 'H1') && heading.id
      )
      state.titleLink = document.querySelector('.toc-link.toc-title')

      // Build heading map
      state.headingMap.clear()
      state.linkList.forEach((link) => {
        const href = link.getAttribute('href')
        if (href?.startsWith('#')) {
          state.headingMap.set(href.substring(1), link)
        }
      })

      return true
    }

    // Check if content exists
    function checkContent() {
      if (!state.container) return

      const tocItems = state.linkList.filter((link) => !link.classList.contains('toc-title'))
      state.hasContent = tocItems.length > 0

      if (!state.hasContent) {
        state.container.style.display = 'none'
      }
    }

    // Adjust TOC position
    function adjustPosition() {
      if (!state.container || !centeredLayout || !state.hasContent) {
        if (state.container) state.container.style.display = 'none'
        clearExpanded()
        return
      }

      const pageWidth = window.innerWidth
      const contentWidthValue = Math.max(parseFloat(contentWidth), 25)
      const margin = (pageWidth - contentWidthValue * 16) / 2
      const baseMinSpace = 11 * 16 // Base minimum space needed
      const minSpace = toc ? baseMinSpace + 52 : baseMinSpace + 12

      if (margin >= minSpace) {
        state.container.style.display = 'block'
        state.container.classList.add('fixed-position')
        const leftPosition = toc ? margin - 176 - 40 : margin - 176
        state.container.style.left = `${leftPosition}px`
      } else {
        state.container.style.display = 'none'
        state.container.classList.remove('fixed-position')
        state.container.style.left = ''
        clearExpanded()
      }
    }

    // Handle click events
    function handleClick(e) {
      const link = e.target.closest('.toc-link')
      if (!link) return

      e.preventDefault()

      if (link.classList.contains('toc-title')) {
        window.scrollTo({ top: 0, behavior: 'smooth' })
        history.pushState(null, null, '#')
      } else {
        const href = link.getAttribute('href')
        if (href?.startsWith('#')) {
          const target = document.getElementById(href.substring(1))
          if (target) {
            const rect = target.getBoundingClientRect()
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop
            const offset = rect.top + scrollTop - jumpOffset
            window.scrollTo({ top: offset, behavior: 'smooth' })
            history.pushState(null, null, href)
          }
        }
      }
    }

    function setActive(nextActiveId) {
      const nextActiveLink =
        nextActiveId && state.headingMap.has(nextActiveId) ? state.headingMap.get(nextActiveId) : state.titleLink

      if (state.activeId === nextActiveId && state.activeLink === nextActiveLink) {
        return
      }

      if (state.activeLink) {
        state.activeLink.classList.remove('active')
      }

      if (nextActiveLink) {
        nextActiveLink.classList.add('active')
      }

      state.activeId = nextActiveId
      state.activeLink = nextActiveLink
    }

    // Collapse the full-title preview.
    function clearExpanded() {
      if (state.container) {
        state.container.classList.remove('expanded')
      }

      state.linkList.forEach((link) => {
        link.classList.remove('is-hovered')
        link.style.removeProperty('--toc-delay')
        link.style.removeProperty('--toc-shift')
      })

      state.expanded = false
      state.hoveredIndex = -1
    }

    // Show every title, staggered outward from the hovered line.
    function expandAt(index) {
      if (!state.container) return
      if (state.expanded && state.hoveredIndex === index) return

      state.expanded = true
      state.hoveredIndex = index
      state.container.classList.add('expanded')

      state.linkList.forEach((link, i) => {
        link.classList.toggle('is-hovered', i === index)
        link.style.setProperty('--toc-delay', `${Math.abs(i - index) * 26}ms`)
        link.style.setProperty('--toc-shift', `${i < index ? -4 : 4}px`)
      })
    }

    function handlePointerMove(event) {
      if (!state.container) return

      const target = event.target
      if (!(target instanceof Element)) return

      const link = target.closest('.toc-link')
      if (!link || !state.container.contains(link)) {
        clearExpanded()
        return
      }

      // The line indicators occupy the first 1.75rem; add a small tolerance.
      const rect = link.getBoundingClientRect()
      if (event.clientX - rect.left <= 2 * 16) {
        const index = state.linkList.indexOf(link)
        if (index !== -1) expandAt(index)
      } else {
        clearExpanded()
      }
    }

    function refreshActiveHeading() {
      if (!state.headingList.length) {
        setActive(null)
        return
      }

      if (window.pageYOffset < 16 || state.headingList[0].getBoundingClientRect().top > activeOffset) {
        setActive(null)
        return
      }

      for (let i = state.headingList.length - 1; i >= 0; i--) {
        if (state.headingList[i].getBoundingClientRect().top <= activeOffset) {
          setActive(state.headingList[i].id)
          break
        }
      }
    }

    function scheduleActiveRefresh() {
      if (state.scrollFrame) {
        return
      }

      state.scrollFrame = requestAnimationFrame(() => {
        state.scrollFrame = null
        refreshActiveHeading()
      })
    }

    // Initialize
    function init(retryCount = 0) {
      const maxRetries = 5

      if (initElements()) {
        checkContent()
        adjustPosition()

        if (state.container) {
          state.container.addEventListener('click', handleClick)
          state.container.addEventListener('pointermove', handlePointerMove)
          state.container.addEventListener('pointerleave', clearExpanded)
        }

        refreshActiveHeading()
      } else if (retryCount < maxRetries) {
        setTimeout(() => init(retryCount + 1), 100)
      }
    }

    // Event handlers
    function handleResize() {
      if (state.resizeTimeout) {
        cancelAnimationFrame(state.resizeTimeout)
      }

      state.resizeTimeout = requestAnimationFrame(() => {
        adjustPosition()
        refreshActiveHeading()
      })
    }

    // Reset DOM-scoped work; destroy() additionally removes global listeners.
    function cleanup() {
      if (state.activeLink) {
        state.activeLink.classList.remove('active')
      }

      if (state.container) {
        state.container.removeEventListener('click', handleClick)
        state.container.removeEventListener('pointermove', handlePointerMove)
        state.container.removeEventListener('pointerleave', clearExpanded)
      }

      clearExpanded()

      if (state.scrollFrame) {
        cancelAnimationFrame(state.scrollFrame)
        state.scrollFrame = null
      }

      if (state.resizeTimeout) {
        cancelAnimationFrame(state.resizeTimeout)
        state.resizeTimeout = null
      }

      if (state.resetTimeout) {
        cancelAnimationFrame(state.resetTimeout)
        state.resetTimeout = null
      }

      Object.assign(state, {
        container: null,
        linkList: [],
        headingList: [],
        titleLink: null,
        headingMap: new Map(),
        scrollFrame: null,
        activeLink: null,
        activeId: null,
        hasContent: false,
        expanded: false,
        hoveredIndex: -1
      })
    }

    function reset() {
      state.resetTimeout = null
      cleanup()
      init()
    }

    function scheduleReset() {
      if (state.resetTimeout) {
        cancelAnimationFrame(state.resetTimeout)
      }

      state.resetTimeout = requestAnimationFrame(reset)
    }

    function destroy() {
      cleanup()
      document.removeEventListener('astro:page-load', scheduleReset)
      document.removeEventListener('astro:after-swap', scheduleReset)
      window.removeEventListener('scroll', scheduleActiveRefresh)
      window.removeEventListener('resize', handleResize)

      if (window.__tocController?.destroy === destroy) {
        window.__tocController = null
      }
    }

    // Event listeners
    document.addEventListener('astro:page-load', scheduleReset)
    document.addEventListener('astro:after-swap', scheduleReset)
    window.addEventListener('scroll', scheduleActiveRefresh, { passive: true })
    window.addEventListener('resize', handleResize)

    window.__tocController = { destroy }
    init()
  })()
</script>

<style is:inline>
  .toc-container {
    width: 12rem;
    position: relative;
    left: -0.175em;
    opacity: 0;
    transition: opacity 0.2s ease-out;
    display: none;
  }

  .toc-container.fixed-position {
    opacity: 1;
    position: fixed;
    top: 12rem;
    margin-top: 0;
    padding-left: 1rem;
    z-index: 10;
    left: auto;
  }

  .toc-nav {
    font-family: var(--sans);
  }

  .toc-list,
  .toc-list li,
  .toc-item {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .prose .toc-container .toc-list {
    margin-left: 0 !important;
    padding-left: 0 !important;
  }

  .prose .toc-container .toc-list li {
    margin: 0 !important;
    padding: 0 !important;
  }

  .toc-item::before,
  .toc-item::marker {
    display: none;
  }

  .toc-link {
    display: block;
    color: transparent;
    text-decoration: none;
    position: relative;
    padding-left: 0;
    height: 1.4rem;
    width: 100%;
    min-height: 1.4rem;
    font-size: 0;
    line-height: 1.4rem;
    text-indent: 2rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    transition:
      color 0.2s ease-out,
      font-size 0.2s ease-out,
      text-indent 0.2s ease-out;
    cursor: pointer;
  }

  .toc-link::after {
    content: attr(data-text);
    position: absolute;
    left: -0.5rem;
    top: 0;
    font-family: var(--sans);
    font-size: var(--font-size-s);
    letter-spacing: var(--spacing-m);
    line-height: 1.4rem;
    color: var(--text-primary);
    opacity: 0;
    transform: translateY(var(--toc-shift, 4px));
    transition:
      opacity 0.15s ease-out,
      left 0.15s ease-out,
      transform 0.15s ease-out,
      color 0.15s ease-out;
    pointer-events: none;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .toc-link:hover::after {
    opacity: 1;
    left: -0.75rem;
    transform: translateY(0);
  }

  .toc-level-0 .toc-link:hover::after {
    opacity: 0;
  }

  /* Hovering the line indicators expands every title in a floating panel. */
  .toc-container.expanded {
    box-sizing: border-box;
    width: 26rem;
    max-width: calc(100vw - 3rem);
    padding-right: 1.5rem;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--bg) 80%, transparent) 0%,
      color-mix(in srgb, var(--bg) 80%, transparent) 70%,
      color-mix(in srgb, var(--bg) 52%, transparent) 88%,
      transparent 100%
    );
    -webkit-backdrop-filter: blur(7px);
    backdrop-filter: blur(7px);
    transition:
      width 0.16s ease-out,
      opacity 0.16s ease-out;
  }

  .toc-container.expanded .toc-link::after {
    left: 2.875rem;
    max-width: calc(100% - 2.875rem);
    text-indent: 0;
    opacity: 1;
    color: var(--text-secondary);
    transform: translateY(0);
    transition-delay: var(--toc-delay, 0ms);
  }

  .toc-container.expanded .toc-link.active::after,
  .toc-container.expanded .toc-link.is-hovered::after {
    color: var(--text-primary);
  }

  /* "Back to top" stays a line-only control. */
  .toc-container.expanded .toc-level-0 .toc-link::after {
    opacity: 0;
  }

  .toc-level-1 .toc-link:hover::before,
  .toc-level-2 .toc-link:hover::before,
  .toc-level-3 .toc-link:hover::before {
    width: 0.75rem;
    transition: width 0.1s ease-out;
  }

  .toc-link.active {
    color: var(--text-primary);
  }

  /* Horizontal line indicators */
  .toc-level-0 .toc-link::before,
  .toc-level-1 .toc-link::before,
  .toc-level-2 .toc-link::before,
  .toc-level-3 .toc-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 1.75rem;
    height: 1px;
    background-color: var(--text-tertiary);
    transform: translateY(-50%);
    opacity: 0.4;
    transition: all 0.1s ease-out;
  }

  .toc-link:hover::before,
  .toc-link.active::before {
    opacity: 0.8;
    background-color: var(--text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-container.expanded,
    .toc-link::after {
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
    }
  }

  /* Hide on mobile */
  @media (max-width: 768px) {
    .toc-container {
      display: none !important;
    }
  }
</style>
