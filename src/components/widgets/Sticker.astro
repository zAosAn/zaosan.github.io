---
// Peelable holographic stickers.
//
// A = CSS scroll-driven animation: the sticker is anchored in the document and
//     the rendering layer is translated by the compositor. The click/hover shield
//     follows the cut shape, and the canvas is re-centred vertically on every
//     scroll so a sticker dragged to an edge is never permanently clipped.
// E = the txt behaviour: the sticker stays in the viewport, nothing scrolls it,
//     and nothing is blocked. Used when the browser is Safari or lacks scroll
//     timelines.
//
// Parameters come from public/stickers/stickers.json, next to the images.
import fs from 'node:fs'
import path from 'node:path'

interface StickerParams {
  cut: number
  finish: string
  material: string
  width: number
  look: Record<string, number>
}

interface Manifest {
  version: number
  stickers: string[]
  params: Record<string, StickerParams>
}

const manifestPath = path.join(process.cwd(), 'public', 'stickers', 'stickers.json')
const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8')) as Manifest
const specs = manifest.stickers.map((file) => ({
  id: file.replace(/\.[^.]+$/, ''),
  src: `/stickers/${encodeURIComponent(file)}`,
  ...(manifest.params[file] ?? {})
}))

interface Props {
  count?: number
  follow?: 'auto' | 'fixed'
  block?: boolean
}

const { count = 1, follow = 'auto', block } = Astro.props as Props
---

<div
  id="holo-sticker-layer"
  class="holo-sticker-layer"
  data-count={count}
  data-follow={follow}
  data-block={block === undefined ? 'auto' : String(block)}
>
  <div class="sticker-stage"></div>
</div>

<script type="application/json" id="sticker-specs" set:html={JSON.stringify(specs)}></script>

<script>
  type StickerSpec = {
    id: string
    src: string
    cut: number
    finish: string
    material: string
    width: number
    look: Record<string, number>
  }

  type Geo = {
    size: [number, number]
    hit: (x: number, y: number) => boolean
  }

  type Sticker = {
    x: number
    y: number
    rot: number
    mode: string
    geo: Geo
  }

  type Board = {
    stickers: Sticker[]
    stage: { toWorld: (x: number, y: number, z?: number) => [number, number] }
    use: (extension: unknown) => unknown
    set: (options: { sound?: boolean }) => void
    kick: () => void
    destroy: () => void
  }

  const LAYER_ID = 'holo-sticker-layer'
  const SOUND_KEY = 'chiri-sticker-sound'
  const RESIDUE_FADE_MS = 300
  const SVG_NS = 'http://www.w3.org/2000/svg'

  let board: Board | null = null
  let stickers: Sticker[] = []
  let shields: { sticker: Sticker; svg: SVGSVGElement }[] = []
  let residueExt: { clear: () => void } | null = null
  let mounting = false
  let followActive = false
  let blockActive = false
  let anchorScroll = 0
  let lastScroll = 0
  let residueTimer = 0
  let residueHidden = false
  let syncRaf = 0
  let syncUntil = 0
  let pointerActive = false

  const layerEl = () => document.getElementById(LAYER_ID)
  const stageEl = () => layerEl()?.querySelector('.sticker-stage') as HTMLElement | null

  const readSound = () => {
    try {
      return localStorage.getItem(SOUND_KEY) !== 'off'
    } catch {
      return true
    }
  }

  const readSpecs = (): StickerSpec[] => {
    const node = document.getElementById('sticker-specs')
    if (!node?.textContent) return []
    try {
      return JSON.parse(node.textContent) as StickerSpec[]
    } catch {
      return []
    }
  }

  const scaledWidth = (width: number) => {
    const vw = innerWidth
    const scale = vw < 480 ? 0.62 : vw < 768 ? 0.75 : vw < 1024 ? 0.88 : 1
    return Math.round(width * scale)
  }

  // Safari (desktop and iOS) and anything without scroll-driven animations use
  // the txt behaviour instead: fixed in the viewport, no blocking.
  const isSafari = () => {
    const ua = navigator.userAgent
    const safari = /Safari\//.test(ua) && !/(Chrome|Chromium|CriOS|FxiOS|EdgiOS|OPiOS|Android)/.test(ua)
    return safari
  }

  const supportsScrollTimeline = () => {
    try {
      return CSS.supports('animation-timeline: scroll()') || CSS.supports('animation-timeline', 'scroll(root block)')
    } catch {
      return false
    }
  }

  const residueCanvases = () =>
    Array.from(document.querySelectorAll<HTMLCanvasElement>('.hs-under.hs-residue, .hs-under.hs-crumbs'))

  const fadeResidue = () => {
    const canvases = residueCanvases()
    if (residueHidden || canvases.length === 0) return
    residueHidden = true
    clearTimeout(residueTimer)
    for (const canvas of canvases) {
      canvas.style.transition = `opacity ${RESIDUE_FADE_MS}ms ease-out`
      canvas.style.opacity = '0'
    }
    residueTimer = window.setTimeout(() => {
      residueExt?.clear()
    }, RESIDUE_FADE_MS + 20)
  }

  const resetResidue = () => {
    if (!residueHidden) return
    residueHidden = false
    clearTimeout(residueTimer)
    residueExt?.clear()
    for (const canvas of residueCanvases()) {
      canvas.style.transition = 'none'
      canvas.style.opacity = '1'
    }
  }

  // The engine only exposes the cut shape through geo.hit; the shield is a path
  // rasterised from it so clicks and hover never reach the content underneath.
  const shieldPath = (sticker: Sticker) => {
    const geo = sticker.geo
    const [width, height] = geo.size
    const step = 2
    const rows = Math.ceil(height / step)
    const cols = Math.ceil(width / step)
    const parts: string[] = []
    for (let row = 0; row < rows; row++) {
      const top = height / 2 - row * step
      const y = top - step / 2
      let run = -1
      for (let col = 0; col <= cols; col++) {
        const inside = col < cols && geo.hit(-width / 2 + col * step + step / 2, y)
        if (inside && run < 0) {
          run = col
        } else if (!inside && run >= 0) {
          const x0 = width / 2 + (-width / 2 + run * step)
          const x1 = width / 2 + (-width / 2 + col * step)
          const y0 = height / 2 - top
          parts.push(`M${x0.toFixed(1)} ${y0.toFixed(1)}H${x1.toFixed(1)}V${(y0 + step).toFixed(1)}H${x0.toFixed(1)}Z`)
          run = -1
        }
      }
    }
    return parts.join('')
  }

  const placeShield = (entry: { sticker: Sticker; svg: SVGSVGElement }) => {
    const [width, height] = entry.sticker.geo.size
    entry.svg.style.transform = `translate3d(${entry.sticker.x}px, ${-entry.sticker.y}px, 0) rotate(${-entry.sticker
      .rot}deg) translate(${-width / 2}px, ${-height / 2}px)`
  }

  const buildShields = () => {
    const stage = stageEl()
    if (!stage) return
    for (const sticker of stickers) {
      const [width, height] = sticker.geo.size
      const svg = document.createElementNS(SVG_NS, 'svg')
      svg.setAttribute('class', 'sticker-shield')
      svg.setAttribute('aria-hidden', 'true')
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`)
      svg.style.width = `${width}px`
      svg.style.height = `${height}px`
      const shape = document.createElementNS(SVG_NS, 'path')
      shape.setAttribute('d', shieldPath(sticker))
      shape.setAttribute('fill', 'rgba(0, 0, 0, 0)')
      shape.setAttribute('pointer-events', 'all')
      svg.appendChild(shape)
      stage.appendChild(svg)
      const entry = { sticker, svg }
      shields.push(entry)
      placeShield(entry)
    }
  }

  const syncShields = () => {
    for (const entry of shields) {
      const stuck = entry.sticker.mode === 'stuck'
      entry.svg.style.display = stuck ? '' : 'none'
      if (stuck) placeShield(entry)
    }
  }

  const tickSync = () => {
    syncRaf = 0
    syncShields()
    if (pointerActive || performance.now() < syncUntil) syncRaf = requestAnimationFrame(tickSync)
  }

  const startSync = (ms = 900) => {
    syncUntil = Math.max(syncUntil, performance.now() + ms)
    if (!syncRaf) syncRaf = requestAnimationFrame(tickSync)
  }

  const randomPlacement = (width: number, height: number) => {
    const overflow = Math.min(Math.min(width, height) * 0.15, 24)
    const minX = width / 2 - overflow
    const maxX = innerWidth - width / 2 + overflow
    const minY = height / 2 - overflow
    const maxY = innerHeight - height / 2 + overflow
    const x = maxX > minX ? minX + Math.random() * (maxX - minX) : innerWidth / 2
    const y = maxY > minY ? minY + Math.random() * (maxY - minY) : innerHeight / 2
    return { x, y }
  }

  const applyStageOffset = () => {
    const stage = stageEl()
    if (stage) stage.style.transform = `translate3d(0, ${anchorScroll}px, 0)`
  }

  const updateRange = () => {
    const layer = layerEl()
    if (!layer) return
    const root = document.documentElement
    layer.style.setProperty('--scroll-range', `${Math.max(0, root.scrollHeight - root.clientHeight)}px`)
  }

  const mount = async () => {
    if (mounting || board) return
    const layer = layerEl()
    const stage = stageEl()
    if (!layer || !stage) return
    const specs = readSpecs()
    if (specs.length === 0) return

    mounting = true
    try {
      const requested = layer.dataset.follow === 'fixed' ? false : true
      followActive = requested && !isSafari() && supportsScrollTimeline()
      const blockSetting = layer.dataset.block
      blockActive = blockSetting === 'auto' ? followActive : blockSetting === 'true'

      if (followActive) {
        layer.dataset.active = 'follow'
        anchorScroll = window.scrollY
        lastScroll = anchorScroll
        applyStageOffset()
        updateRange()
      }

      const engineUrl = '/vendor/holo-stickers-1.0.0.min.js'
      const extrasUrl = '/vendor/holo-stickers-extras-1.0.0.min.js'
      const engine = await import(/* @vite-ignore */ engineUrl)
      const extras = await import(/* @vite-ignore */ extrasUrl)

      if (!layer.isConnected || !stage.isConnected) return

      const count = Math.max(1, Number(layer.dataset.count) || 1)
      const pool = [...specs]
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1))
        ;[pool[i], pool[j]] = [pool[j], pool[i]]
      }
      const chosen = Array.from({ length: count }, (_, index) => pool[index % pool.length])

      const instance: Board = await engine.createStickers({
        container: stage,
        stickers: chosen.map((spec) => ({
          ...spec,
          width: scaledWidth(spec.width),
          rotation: Math.round((Math.random() * 2 - 1) * 45),
          at: [0, 0]
        })),
        sound: false
      })

      if (!layer.isConnected || !stage.isConnected) {
        instance.destroy()
        return
      }

      board = instance
      stickers = instance.stickers.slice()
      residueExt = instance.use(extras.residue()) as { clear: () => void }
      instance.use(extras.bubbles())

      if (followActive) {
        const native = instance.stage.toWorld.bind(instance.stage)
        instance.stage.toWorld = (x: number, y: number, z = 0) => native(x, y - anchorScroll + window.scrollY, z)
      }

      for (const sticker of stickers) {
        const [width, height] = sticker.geo.size
        const target = randomPlacement(width, height)
        sticker.x = target.x - innerWidth / 2
        sticker.y = innerHeight / 2 - target.y
      }
      instance.kick()

      if (blockActive) buildShields()
      syncShields()
      startSync(1800)

      const enableSound = () => {
        window.removeEventListener('pointerdown', enableSound, true)
        if (board === instance && readSound()) instance.set({ sound: true })
      }
      window.addEventListener('pointerdown', enableSound, true)
    } finally {
      mounting = false
    }
  }

  const unmount = () => {
    const instance = board
    board = null
    stickers = []
    residueExt = null
    clearTimeout(residueTimer)
    if (pendingShift) {
      clearTimeout(pendingShift)
      pendingShift = 0
    }
    residueHidden = false
    if (syncRaf) cancelAnimationFrame(syncRaf)
    syncRaf = 0
    for (const entry of shields) entry.svg.remove()
    shields = []
    if (!instance) return
    instance.set({ sound: false })
    const sound = (instance as unknown as { sound?: { idle?: number } }).sound
    if (sound?.idle) clearTimeout(sound.idle)
    instance.destroy()
  }

  // Re-centre vertically: shift the stage and the sticker's own coordinates
  // together. The sticker stays put on screen while the drawable canvas follows
  // it, so a sticker dragged to an edge is never clipped for good.
  let pendingShift = 0
  const applyVerticalShift = () => {
    if (!followActive || stickers.length !== 1) return
    const sticker = stickers[0]
    const shift = sticker.y
    if (shift === 0) return
    anchorScroll -= shift
    sticker.y = 0
    applyStageOffset()
    board?.kick()
    for (const entry of shields) placeShield(entry)
  }

  // A: the layer is driven by a scroll animation, so the JS only has to keep the
  // smudges tidy and re-centre the canvas vertically.
  const onScroll = () => {
    if (!followActive) return
    lastScroll = window.scrollY
    const wasHidden = residueHidden
    fadeResidue()
    if (stickers.length !== 1 || stickers[0].y === 0 || pendingShift) return
    // The smudges live in the same stage; shifting it would move them abruptly.
    // Wait for the fade (already started above) before moving the canvas.
    if (wasHidden) {
      applyVerticalShift()
      return
    }
    pendingShift = window.setTimeout(() => {
      pendingShift = 0
      applyVerticalShift()
    }, RESIDUE_FADE_MS + 60)
  }

  const onResize = () => {
    if (!followActive) return
    updateRange()
    startSync(400)
  }

  document.addEventListener('astro:page-load', mount)
  document.addEventListener('astro:before-swap', unmount)
  window.addEventListener('scroll', onScroll, { passive: true })
  window.addEventListener('resize', onResize)
  window.addEventListener('pointerdown', () => {
    pointerActive = true
    resetResidue()
    startSync(400)
  })
  window.addEventListener('pointerup', () => {
    pointerActive = false
    startSync(1200)
  })
  window.addEventListener('pointercancel', () => {
    pointerActive = false
    startSync(1200)
  })
  document.addEventListener('sticker:sound', ((event: CustomEvent<{ on: boolean }>) => {
    board?.set({ sound: event.detail.on })
  }) as EventListener)

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mount, { once: true })
  } else {
    mount()
  }
</script>

<style is:global>
  .holo-sticker-layer {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    will-change: transform;
  }

  .sticker-stage {
    position: fixed;
    inset: 0;
    pointer-events: none;
    will-change: transform;
  }

  /* A: the whole layer follows the scroll on the compositor. */
  @supports (animation-timeline: scroll()) {
    .holo-sticker-layer[data-active='follow'] {
      animation: sticker-scroll linear both;
      animation-timeline: scroll(root block);
    }
  }

  @keyframes sticker-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(0, calc(-1 * var(--scroll-range, 0px)), 0);
    }
  }

  .sticker-shield {
    position: fixed;
    left: 50%;
    top: 50%;
    transform-origin: 0 0;
    z-index: 3;
    pointer-events: none;
    overflow: visible;
  }
</style>
