---
// Peelable holographic stickers.
//
// The layer is not an overlay on the viewport: it is an absolutely positioned,
// one-viewport-tall box inside the document, so the browser's own scrolling
// carries the stickers (and their smudges) with the page. Nothing runs on
// scroll, there is no scroll-driven animation to fall back from, and Safari
// takes the same path as everything else.
//
// Dropping a sticker re-anchors that box: the layer's `top` and the sticker's
// own coordinates move together in the same frame, so the sticker does not
// budge on screen while the drawing area re-centres on it. That is what stops a
// sticker dragged to an edge from being clipped for good.
//
// Parameters come from public/stickers/stickers.json, next to the images.
import fs from 'node:fs'
import path from 'node:path'

interface StickerParams {
  cut: number
  finish: string
  material: string
  width: number
  look: Record<string, number>
}

interface Manifest {
  version: number
  stickers: string[]
  params: Record<string, StickerParams>
}

const manifestPath = path.join(process.cwd(), 'public', 'stickers', 'stickers.json')
const manifest = JSON.parse(fs.readFileSync(manifestPath, 'utf8')) as Manifest
const specs = manifest.stickers.map((file) => ({
  id: file.replace(/\.[^.]+$/, ''),
  src: `/stickers/${encodeURIComponent(file)}`,
  ...(manifest.params[file] ?? {})
}))

interface Props {
  count?: number
  block?: boolean
}

const { count = 1, block } = Astro.props as Props
---

<div
  id="holo-sticker-layer"
  class="holo-sticker-layer"
  data-count={count}
  data-block={block === undefined ? 'auto' : String(block)}
>
  <div class="sticker-stage"></div>
</div>

<script type="application/json" id="sticker-specs" set:html={JSON.stringify(specs)}></script>

<script>
  type StickerSpec = {
    id: string
    src: string
    cut: number
    finish: string
    material: string
    width: number
    look: Record<string, number>
  }

  type Geo = {
    size: [number, number]
    hit: (x: number, y: number) => boolean
  }

  type Sticker = {
    x: number
    y: number
    rot: number
    mode: string
    geo: Geo
  }

  type Board = {
    stickers: Sticker[]
    stage: { toWorld: (x: number, y: number, z?: number) => [number, number] }
    use: (extension: unknown) => unknown
    set: (options: { sound?: boolean }) => void
    kick: () => void
    resize: () => void
    destroy: () => void
  }

  const LAYER_ID = 'holo-sticker-layer'
  const SOUND_KEY = 'chiri-sticker-sound'
  const RESIDUE_FADE_MS = 300
  const SVG_NS = 'http://www.w3.org/2000/svg'

  let board: Board | null = null
  let stickers: Sticker[] = []
  let shields: { sticker: Sticker; svg: SVGSVGElement; size: [number, number] }[] = []
  let residueExt: { clear: () => void } | null = null
  let mounting = false
  let blockActive = false
  // Where the layer's top sits in the document, and where the layer would sit
  // with `top: 0`; the two differ by whatever the page wrapper adds above it.
  let anchorScroll = 0
  let layerBase = 0
  let lastWidth = 0
  let lastModes: string[] = []
  let residueTimer = 0
  let residueHidden = false
  let syncRaf = 0
  let syncUntil = 0
  let pointerActive = false

  const layerEl = () => document.getElementById(LAYER_ID)
  const stageEl = () => layerEl()?.querySelector('.sticker-stage') as HTMLElement | null

  const readSound = () => {
    try {
      return localStorage.getItem(SOUND_KEY) !== 'off'
    } catch {
      return true
    }
  }

  const readSpecs = (): StickerSpec[] => {
    const node = document.getElementById('sticker-specs')
    if (!node?.textContent) return []
    try {
      return JSON.parse(node.textContent) as StickerSpec[]
    } catch {
      return []
    }
  }

  const scaledWidth = (width: number) => {
    const vw = innerWidth
    const scale = vw < 480 ? 0.62 : vw < 768 ? 0.75 : vw < 1024 ? 0.88 : 1
    return Math.round(width * scale)
  }

  const residueCanvases = () =>
    Array.from(document.querySelectorAll<HTMLCanvasElement>('.hs-under.hs-residue, .hs-under.hs-crumbs'))

  const fadeResidue = () => {
    const canvases = residueCanvases()
    if (residueHidden || canvases.length === 0) return
    residueHidden = true
    clearTimeout(residueTimer)
    for (const canvas of canvases) {
      canvas.style.transition = `opacity ${RESIDUE_FADE_MS}ms ease-out`
      canvas.style.opacity = '0'
    }
    residueTimer = window.setTimeout(() => {
      residueExt?.clear()
    }, RESIDUE_FADE_MS + 20)
  }

  const resetResidue = () => {
    if (!residueHidden) return
    residueHidden = false
    clearTimeout(residueTimer)
    residueExt?.clear()
    for (const canvas of residueCanvases()) {
      canvas.style.transition = 'none'
      canvas.style.opacity = '1'
    }
  }

  // The engine only exposes the cut shape through geo.hit; the shield is a path
  // rasterised from it so clicks and hover never reach the content underneath.
  const shieldPath = (sticker: Sticker) => {
    const geo = sticker.geo
    const [width, height] = geo.size
    const step = 2
    const rows = Math.ceil(height / step)
    const cols = Math.ceil(width / step)
    const parts: string[] = []
    for (let row = 0; row < rows; row++) {
      const top = height / 2 - row * step
      const y = top - step / 2
      let run = -1
      for (let col = 0; col <= cols; col++) {
        const inside = col < cols && geo.hit(-width / 2 + col * step + step / 2, y)
        if (inside && run < 0) {
          run = col
        } else if (!inside && run >= 0) {
          const x0 = width / 2 + (-width / 2 + run * step)
          const x1 = width / 2 + (-width / 2 + col * step)
          const y0 = height / 2 - top
          parts.push(`M${x0.toFixed(1)} ${y0.toFixed(1)}H${x1.toFixed(1)}V${(y0 + step).toFixed(1)}H${x0.toFixed(1)}Z`)
          run = -1
        }
      }
    }
    return parts.join('')
  }

  type Shield = { sticker: Sticker; svg: SVGSVGElement; size: [number, number] }

  const placeShield = (entry: Shield) => {
    const [width, height] = entry.sticker.geo.size
    entry.svg.style.transform = `translate3d(${entry.sticker.x}px, ${-entry.sticker.y}px, 0) rotate(${-entry.sticker
      .rot}deg) translate(${-width / 2}px, ${-height / 2}px)`
  }

  const buildShield = (sticker: Sticker): Shield | null => {
    const stage = stageEl()
    if (!stage) return null
    const [width, height] = sticker.geo.size
    const svg = document.createElementNS(SVG_NS, 'svg')
    svg.setAttribute('class', 'sticker-shield')
    svg.setAttribute('aria-hidden', 'true')
    const shape = document.createElementNS(SVG_NS, 'path')
    shape.setAttribute('fill', 'rgba(0, 0, 0, 0)')
    shape.setAttribute('pointer-events', 'all')
    svg.appendChild(shape)
    stage.appendChild(svg)
    const entry: Shield = { sticker, svg, size: [width, height] }
    reshapeShield(entry)
    return entry
  }

  // A torn sticker gets a new outline, and the piece torn off is a separate
  // sticker; both need their own shield or the old one would keep blocking a
  // shape that is no longer there.
  const reshapeShield = (entry: Shield) => {
    const [width, height] = entry.sticker.geo.size
    const shape = entry.svg.firstChild as SVGPathElement
    entry.svg.setAttribute('viewBox', `0 0 ${width} ${height}`)
    entry.svg.style.width = `${width}px`
    entry.svg.style.height = `${height}px`
    shape.setAttribute('d', shieldPath(entry.sticker))
    entry.size = [width, height]
    placeShield(entry)
  }

  const syncShields = () => {
    const all = board?.stickers ?? []
    for (let index = shields.length - 1; index >= 0; index--) {
      if (!all.includes(shields[index].sticker)) {
        shields[index].svg.remove()
        shields.splice(index, 1)
      }
    }
    for (const sticker of all) {
      let entry = shields.find((candidate) => candidate.sticker === sticker)
      if (!entry) {
        const built = buildShield(sticker)
        if (!built) continue
        shields.push(built)
        entry = built
      } else if (entry.size[0] !== sticker.geo.size[0] || entry.size[1] !== sticker.geo.size[1]) {
        reshapeShield(entry)
      }
      const stuck = sticker.mode === 'stuck'
      entry.svg.style.display = stuck ? '' : 'none'
      if (stuck) placeShield(entry)
    }
  }

  const tickSync = () => {
    syncRaf = 0
    recenterAfterSettle()
    syncShields()
    if (pointerActive || performance.now() < syncUntil) syncRaf = requestAnimationFrame(tickSync)
  }

  const startSync = (ms = 900) => {
    syncUntil = Math.max(syncUntil, performance.now() + ms)
    if (!syncRaf) syncRaf = requestAnimationFrame(tickSync)
  }

  const randomPlacement = (width: number, height: number) => {
    const overflow = Math.min(Math.min(width, height) * 0.15, 24)
    const minX = width / 2 - overflow
    const maxX = innerWidth - width / 2 + overflow
    const minY = height / 2 - overflow
    const maxY = innerHeight - height / 2 + overflow
    const x = maxX > minX ? minX + Math.random() * (maxX - minX) : innerWidth / 2
    const y = maxY > minY ? minY + Math.random() * (maxY - minY) : innerHeight / 2
    return { x, y }
  }

  const applyLayerAnchor = () => {
    const layer = layerEl()
    if (layer) layer.style.top = `${anchorScroll - layerBase}px`
  }

  // The engine sizes everything from `innerWidth`/`innerHeight`, and on a phone
  // `innerHeight` changes whenever the toolbar slides in or out. Each of those
  // resizes the drawing buffer and re-centres the sticker, which is the jump:
  // freeze the box at the height it was mounted at, and only follow a change of
  // width (rotation), which really does change the layout.
  const pinLayerHeight = () => {
    const layer = layerEl()
    if (!layer) return
    layer.style.height = `${Math.round(innerHeight)}px`
  }

  const mount = async () => {
    if (mounting || board) return
    const layer = layerEl()
    const stage = stageEl()
    if (!layer || !stage) return
    const specs = readSpecs()
    if (specs.length === 0) return

    mounting = true
    try {
      blockActive = layer.dataset.block !== 'false'

      // The layer is a box in the document, so it only covers the viewport it
      // was anchored to; line that up with where the reader already is. It sits
      // at the top level so the page's column width cannot crop it.
      if (layer.parentElement !== document.body) document.body.appendChild(layer)
      layer.style.top = '0px'
      pinLayerHeight()
      layerBase = layer.getBoundingClientRect().top + window.scrollY
      anchorScroll = window.scrollY
      applyLayerAnchor()
      lastWidth = innerWidth

      const engineUrl = '/vendor/holo-stickers-1.0.0.min.js'
      const extrasUrl = '/vendor/holo-stickers-extras-1.0.0.min.js'
      const engine = await import(/* @vite-ignore */ engineUrl)
      const extras = await import(/* @vite-ignore */ extrasUrl)

      if (!layer.isConnected || !stage.isConnected) return

      const count = Math.max(1, Number(layer.dataset.count) || 1)
      const pool = [...specs]
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1))
        ;[pool[i], pool[j]] = [pool[j], pool[i]]
      }
      const chosen = Array.from({ length: count }, (_, index) => pool[index % pool.length])

      const instance: Board = await engine.createStickers({
        container: stage,
        stickers: chosen.map((spec) => ({
          ...spec,
          width: scaledWidth(spec.width),
          rotation: Math.round((Math.random() * 2 - 1) * 45),
          at: [0, 0]
        })),
        sound: false
      })

      if (!layer.isConnected || !stage.isConnected) {
        instance.destroy()
        return
      }

      board = instance
      stickers = instance.stickers.slice()
      lastModes = []
      residueExt = instance.use(extras.residue()) as { clear: () => void }
      instance.use(extras.bubbles())

      // The engine works in viewport coordinates; the layer is laid out in the
      // document, so point it at the box's own position in the page.
      const native = instance.stage.toWorld.bind(instance.stage)
      instance.stage.toWorld = (x: number, y: number, z = 0) => native(x, y + window.scrollY - anchorScroll, z)

      // A toolbar sliding is a resize with the same width, and it must not reach
      // the engine: it would resize the buffer, re-centre the sticker and leave
      // the click shield a few dozen pixels away from the artwork.
      const resize = instance.resize.bind(instance)
      instance.resize = () => {
        if (innerWidth === lastWidth) return
        lastWidth = innerWidth
        pinLayerHeight()
        resize()
      }

      // Convert from the box that actually got drawn, not from `innerWidth`.
      const canvasEl = layer.querySelector('.hs-canvas') as HTMLElement | null
      const box = (canvasEl ?? stage).getBoundingClientRect()
      for (const sticker of stickers) {
        const [width, height] = sticker.geo.size
        const target = randomPlacement(width, height)
        sticker.x = target.x - box.left - box.width / 2
        sticker.y = box.height / 2 - (target.y - box.top)
      }
      instance.kick()

      if (blockActive) syncShields()
      startSync(1800)

      const enableSound = () => {
        window.removeEventListener('pointerdown', enableSound, true)
        if (board === instance && readSound()) instance.set({ sound: true })
      }
      window.addEventListener('pointerdown', enableSound, true)
    } finally {
      mounting = false
    }
  }

  const unmount = () => {
    const instance = board
    board = null
    stickers = []
    lastModes = []
    residueExt = null
    clearTimeout(residueTimer)
    if (pendingShift) {
      clearTimeout(pendingShift)
      pendingShift = 0
    }
    residueHidden = false
    if (syncRaf) cancelAnimationFrame(syncRaf)
    syncRaf = 0
    for (const entry of shields) entry.svg.remove()
    shields = []
    if (!instance) return
    instance.set({ sound: false })
    const sound = (instance as unknown as { sound?: { idle?: number } }).sound
    if (sound?.idle) clearTimeout(sound.idle)
    instance.destroy()
  }

  // Put the box back around the sticker with the smallest move that keeps it
  // clear of the box's own edges: no clipping, and the box stays level with the
  // viewport, so the sticker never ends up in a part of the window it cannot be
  // reached from. Never push the box past the end of the page either.
  const recentreAnchor = (all: Sticker[], height: number) => {
    const max = Math.max(0, document.body.getBoundingClientRect().height - height)
    let lower = 0
    let upper = Number.POSITIVE_INFINITY
    let middle = 0
    for (const sticker of all) {
      const halfHeight = sticker.geo.size[1] / 2 + 10
      const docY = anchorScroll + height / 2 - sticker.y
      middle += docY / all.length
      lower = Math.max(lower, docY + halfHeight - height)
      upper = Math.min(upper, docY - halfHeight)
    }
    if (lower > upper) return Math.max(0, Math.min(max, middle - height / 2))
    return Math.min(Math.max(window.scrollY, lower), Math.min(upper, max))
  }

  // Move the anchor and every sticker's own coordinates together, in the same
  // frame, so nothing budges on screen. A torn sticker is two stickers, and
  // moving only one of them is what made the other piece jump.
  let pendingShift = 0
  const applyVerticalShift = () => {
    const all = board?.stickers ?? []
    const layer = layerEl()
    if (all.length === 0 || !layer) return
    const height = layer.getBoundingClientRect().height || innerHeight
    const anchor = recentreAnchor(all, height)
    const delta = anchor - anchorScroll
    if (delta === 0) return
    anchorScroll = anchor
    for (const sticker of all) sticker.y += delta
    applyLayerAnchor()
    board?.kick()
    for (const entry of shields) placeShield(entry)
  }

  // The shift moves the smudges too, so fade them out first and only then move
  // the layer; otherwise they jump.
  const scheduleVerticalShift = () => {
    if (!board?.stickers.length || pendingShift) return
    const canvases = residueCanvases()
    const hasSmudges =
      !residueHidden &&
      canvases.some((canvas) => {
        const ctx = canvas.getContext('2d')
        if (!ctx) return false
        const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data
        for (let i = 3; i < data.length; i += 4) if (data[i] > 0) return true
        return false
      })
    if (!hasSmudges) {
      applyVerticalShift()
      return
    }
    residueHidden = true
    clearTimeout(residueTimer)
    for (const canvas of canvases) {
      canvas.style.transition = 'opacity 120ms ease-out'
      canvas.style.opacity = '0'
    }
    residueTimer = window.setTimeout(() => {
      residueExt?.clear()
    }, 140)
    pendingShift = window.setTimeout(() => {
      pendingShift = 0
      applyVerticalShift()
    }, 150)
  }

  // Re-centre as soon as any sticker is put back down, not on scroll. Pieces torn
  // off are separate stickers, so this watches the whole board, not just the one
  // that was on it at load.
  const recenterAfterSettle = () => {
    const all = board?.stickers ?? []
    if (all.length === 0) return
    const settled = all.some((sticker, index) => {
      const before = lastModes[index]
      return sticker.mode === 'stuck' && before !== undefined && before !== 'stuck'
    })
    lastModes = all.map((sticker) => sticker.mode)
    if (settled) scheduleVerticalShift()
  }

  // Scrolling itself is the browser's job now; the only thing left to watch for
  // is the smudges, which fade away once the page moves. The guard comes first
  // so a scroll that has nothing to fade costs a single boolean test.
  const onScroll = () => {
    if (residueHidden) return
    fadeResidue()
  }

  // A height-only resize is a toolbar sliding, and the box stays where it is for
  // it; the engine's own resize is filtered in `mount`.
  const onResize = () => {
    startSync(400)
  }

  document.addEventListener('astro:page-load', mount)
  document.addEventListener('astro:before-swap', unmount)
  window.addEventListener('scroll', onScroll, { passive: true })
  window.addEventListener('resize', onResize)
  window.addEventListener('pointerdown', () => {
    pointerActive = true
    resetResidue()
    startSync(400)
  })
  window.addEventListener('pointerup', () => {
    pointerActive = false
    startSync(1200)
  })
  window.addEventListener('pointercancel', () => {
    pointerActive = false
    startSync(1200)
  })
  document.addEventListener('sticker:sound', ((event: CustomEvent<{ on: boolean }>) => {
    board?.set({ sound: event.detail.on })
  }) as EventListener)

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mount, { once: true })
  } else {
    mount()
  }
</script>

<style is:global>
  /* A box in the document, not an overlay on the viewport: scrolling it is the
     browser's own work, so there is nothing to keep in sync. */
  .holo-sticker-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    z-index: 2;
    pointer-events: none;
  }

  .sticker-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* The engine lays its own layers over the viewport by default; inside this
     box they have to move with it, or the smudges would stay behind. Their size
     is pinned to the box too: the engine's own rule uses `100dvh`, which changes
     whenever a mobile toolbar slides away, and that resize dragged the sticker
     with it. */
  .holo-sticker-layer .hs-canvas,
  .holo-sticker-layer .hs-dom,
  .holo-sticker-layer .hs-under {
    position: absolute;
    width: 100%;
    height: 100%;
  }

  .holo-sticker-layer .hs-ring {
    position: absolute;
  }

  .sticker-shield {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-origin: 0 0;
    z-index: 3;
    pointer-events: none;
    overflow: visible;
  }
</style>
