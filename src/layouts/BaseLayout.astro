---
import { themeConfig } from '@/config'
import { ClientRouter } from 'astro:transitions'
import ThemeManager from '@/components/ui/ThemeManager.astro'
import AstigmatismFilter from '@/components/ui/AstigmatismFilter.astro'
import TransitionWrapper from '@/components/layout/TransitionWrapper.astro'
import type { LayoutProps } from '@/types'

type Props = LayoutProps

const { type = 'page' } = Astro.props
const language = themeConfig.site.language || 'en-US'
const contentWidth = themeConfig.general.contentWidth
const fadeAnimation = themeConfig.general.fadeAnimation
const widthValue = Math.min(parseFloat(contentWidth), 50)
const shouldUseCustomWidth = widthValue > 25
const finalWidth = shouldUseCustomWidth ? `${widthValue}rem` : '25rem'
---

<html lang={language}>
  <head>
    <ThemeManager />
    <script is:inline>
      ;(function () {
        // Each page view has a 1-in-37 chance to start blurred, even when the
        // user has not turned it on manually.
        const randomBlur = Math.random() < 1 / 37
        try {
          if (localStorage.getItem('chiri-astigmatism') === 'on' || randomBlur) {
            document.documentElement.classList.add('astigmatism')
          }
        } catch {
          // localStorage can be unavailable (private mode); the random roll still applies.
          if (randomBlur) {
            document.documentElement.classList.add('astigmatism')
          }
        }
      })()
    </script>
    {fadeAnimation && <ClientRouter />}
    <slot name="head" />
  </head>
  <body
    data-centered={themeConfig.general.centeredLayout}
    style={`
      max-width: ${finalWidth};
      ${shouldUseCustomWidth ? `--content-width: ${widthValue}rem;` : ''}
    `}
  >
    <AstigmatismFilter />
    {fadeAnimation ? (
      <TransitionWrapper type={type} class="layout-wrapper">
        <slot />
      </TransitionWrapper>
    ) : (
      <div class="layout-wrapper">
        <slot />
      </div>
    )}

    <script is:inline define:vars={{ fadeAnimation }}>
      if (!fadeAnimation) {
        const dispatchPageLoad = () => {
          document.dispatchEvent(new Event('astro:page-load'))
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', dispatchPageLoad, { once: true })
        } else {
          queueMicrotask(dispatchPageLoad)
        }
      }
    </script>
  </body>
</html>

<style is:global>
  .layout-wrapper {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }
</style>
