---
import IndexLayout from '@/layouts/IndexLayout.astro'
import About from '@/components/widgets/About.astro'
import PostList from '@/components/widgets/PostList.astro'
import Sticker from '@/components/widgets/Sticker.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'

const allPosts = await getSortedFilteredPosts()
const limit = themeConfig.post.postListLimit
const posts = limit > 0 ? allPosts.slice(0, limit) : allPosts
---

<IndexLayout title={themeConfig.site.title} description={themeConfig.site.description}>
  <About />
  <hr class="section-rule" />
  <PostList posts={posts} />
  <hr class="section-rule section-rule--tight" />
  <nav class="archive-links" aria-label="All posts and tags">
    <a href="/allpost/">[Allpost]</a>
    <a href="/tags/">[Tags]</a>
  </nav>
  <Sticker />
</IndexLayout>

<style>
  .section-rule {
    width: 100%;
    border: 0;
    border-top: 0.5px solid var(--border);
    margin: 2.75rem 0 1.75rem;
  }

  .section-rule--tight {
    margin: 1.5rem 0 1.25rem;
  }

  .archive-links {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2.5rem;
    font-family: var(--sans);
    font-size: var(--font-size-s);
    letter-spacing: var(--spacing-m);
  }

  .archive-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease-out;
  }

  .archive-links a:hover,
  .archive-links a:focus-visible {
    color: var(--text-primary);
  }
</style>

<style is:global>
  /*
    Home only: this stylesheet is bundled with `/` and nowhere else, and the
    `:has(.archive-links)` guard keeps the rule from leaking if it is ever
    included globally. Article pages keep normal text selection.
  */
  body:has(.archive-links) {
    -webkit-user-select: none;
    user-select: none;
  }
</style>
