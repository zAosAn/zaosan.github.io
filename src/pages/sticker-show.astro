---
import IndexLayout from '@/layouts/IndexLayout.astro'
import Sticker from '@/components/widgets/Sticker.astro'
---

<IndexLayout title="Sticker show" description="三张贴纸的随机展示">
  <div class="sticker-show-actions">
    <button id="sticker-reroll" type="button">
      [ReRoll]
    </button>
    <p>该页面尺寸已被锁定，作为展示页面</p>
  </div>
  <Sticker count={3} block={true} residue="keep" />
</IndexLayout>

<script is:inline data-astro-rerun>
  ;(() => {
    // `data-astro-rerun` matters: without it this never runs when the page is
    // reached through a client-side navigation, which left the button dead and
    // the page scrollable.
    const root = document.documentElement
    root.classList.add('sticker-show')
    document.addEventListener(
      'astro:before-swap',
      () => {
        root.classList.remove('sticker-show')
        const meta = document.querySelector('meta[name="viewport"]')
        if (meta) meta.setAttribute('content', 'width=device-width, initial-scale=1')
      },
      { once: true }
    )

    const meta = document.querySelector('meta[name="viewport"]')
    if (meta) {
      meta.setAttribute('content', 'width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no')
    }

    const button = document.getElementById('sticker-reroll')
    if (button && !button.dataset.bound) {
      button.dataset.bound = 'true'
      let rolling = 0
      button.addEventListener('click', () => {
        if (rolling) return
        rolling = window.setTimeout(() => {
          rolling = 0
          button.classList.remove('is-rolling')
        }, 700)
        button.classList.add('is-rolling')
        // The sticker layer owns the board; it redraws with a different set in
        // place, so there is no page reload to sit through.
        document.dispatchEvent(new Event('sticker:reroll'))
      })
    }
  })()
</script>

<style is:global>
  html.sticker-show,
  html.sticker-show body {
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
    overscroll-behavior: none;
    /* no dragging a selection across the demo */
    user-select: none;
    -webkit-user-select: none;
  }

  html.sticker-show .page-content {
    height: 100dvh;
  }

  /* Below the sticker layer (z-index 2 inside .layout-wrapper) on purpose: a
     sticker that lands here is allowed to cover and block this button. */
  .sticker-show-actions {
    position: fixed;
    left: 50%;
    top: 50%;
    z-index: 0;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
  }

  #sticker-reroll {
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: 0.25rem;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    font-family: var(--mono);
    font-size: var(--font-size-s);
    letter-spacing: 0.02em;
    cursor: pointer;
    pointer-events: auto;
    transition:
      background 0.15s ease,
      transform 0.12s ease,
      opacity 0.2s ease;
  }

  #sticker-reroll:hover,
  #sticker-reroll:focus-visible {
    background: rgba(0, 0, 0, 0.8);
  }

  #sticker-reroll:active {
    transform: scale(0.94);
  }

  /* the new set is being swapped in: no second click, and no reload spinner */
  #sticker-reroll.is-rolling {
    opacity: 0.45;
    transform: scale(0.96);
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    #sticker-reroll {
      transition: none;
    }
  }

  .sticker-show-actions p {
    margin: 0.5rem 0 0;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.01em;
    color: var(--text-tertiary);
  }
</style>
