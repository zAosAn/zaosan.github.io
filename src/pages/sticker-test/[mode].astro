---
import IndexLayout from '@/layouts/IndexLayout.astro'
import About from '@/components/widgets/About.astro'
import PostList from '@/components/widgets/PostList.astro'
import StickerLab from '@/components/widgets/StickerLab.astro'
import { themeConfig } from '@/config'
import { getSortedFilteredPosts } from '@/utils/draft'

export function getStaticPaths() {
  return [
    { params: { mode: 'a' } },
    { params: { mode: 'b' } },
    { params: { mode: 'c' } },
    { params: { mode: 'd' } },
    { params: { mode: 'e' } },
    { params: { mode: 'g' } },
    { params: { mode: 'h' } }
  ]
}

const { mode = 'a' } = Astro.params
const labels: Record<string, string> = {
  a: 'A · CSS 滚动驱动动画（遮挡层开）',
  b: 'B · rAF + transform（遮挡层开）',
  c: 'C · 现行 scroll 事件（遮挡层开）',
  d: 'D · 现行 scroll 事件（无遮挡层，现状对照）',
  e: 'E · 不跟随，txt 行为（无遮挡层）',
  g: 'G · 2× 画布（A + 画布上下各多半个视口，关闭重锚）',
  h: 'H · 提前重锚（A，离边缘 12% 视口时重锚）'
}

const allPosts = await getSortedFilteredPosts()
const limit = themeConfig.post.postListLimit
const posts = limit > 0 ? allPosts.slice(0, limit) : allPosts
const shield = mode !== 'd' && mode !== 'e'
---

<IndexLayout title={`贴纸测试 ${mode.toUpperCase()}`} description="贴纸滚动方案对比测试页">
  <p class="lab-label">{labels[mode] ?? mode}</p>
  <About />
  <hr class="section-rule" />
  <PostList posts={posts} />
  <hr class="section-rule section-rule--tight" />
  <nav class="archive-links" aria-label="All posts and tags">
    <a href="/allpost/">[Allpost]</a>
    <a href="/tags/">[Tags]</a>
  </nav>
  <StickerLab mode={mode} shield={shield} />
</IndexLayout>

<style>
  .lab-label {
    margin: 0 0 1.5rem;
    font-family: var(--mono);
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .section-rule {
    width: 100%;
    border: 0;
    border-top: 0.5px solid var(--border);
    margin: 2.75rem 0 1.75rem;
  }

  .section-rule--tight {
    margin: 1.5rem 0 1.25rem;
  }

  .archive-links {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2.5rem;
    font-family: var(--sans);
    font-size: var(--font-size-s);
    letter-spacing: var(--spacing-m);
  }

  .archive-links a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease-out;
  }

  .archive-links a:hover,
  .archive-links a:focus-visible {
    color: var(--text-primary);
  }
</style>
